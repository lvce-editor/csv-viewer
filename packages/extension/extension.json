{
  "id": "builtin.csv-viewer",
  "name": "CSV Viewer",
  "description": "CSV Viewer",
  "browser": "dist/csvViewerMain.js",
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "isolated": true,
  "workerName": "CSV Viewer Worker",
  "activation": ["onView:builtin.csv-viewer"],
  "repository": "https://github.com/lvce-editor/csv-viewer",
  "languages": [],
  "views": [
    {
      "id": "builtin.csv-viewer",
      "title": "CSV Viewer",
      "kind": "virtualDom",
      "type": "preview",
      "css": "media/index.css",
      "selector": [".csv"],
      "showSideBarHeader": false
    }
  ]
}
